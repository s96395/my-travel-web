{
  "installCommand": "cd app && npm ci",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "next": true
    }
  },
  "crons": [
    {
      "path": "/api/geo-cleanup",
      "schedule": "0 19 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "has": [{ "type": "host", "value": "my-travel-web-pi.vercel.app" }],
      "destination": "https://my-travel-app-af5e5.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://my-travel-test-7812e.firebaseapp.com/__/auth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!__/auth/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/firebase-config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
