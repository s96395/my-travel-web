rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemOwner() {
      return isSignedIn()
        && request.auth.token.email == 's96395@gmail.com';
    }

    function canAccessTripData(tripData) {
      return isSignedIn()
        && (
          isSystemOwner()
          || tripData.ownerId == request.auth.uid
          || (tripData.memberIds is list && request.auth.uid in tripData.memberIds)
        );
    }

    function canListTripData(tripData) {
      return isSignedIn()
        && (
          isSystemOwner()
          || tripData.ownerId == request.auth.uid
          || request.auth.uid in tripData.memberIds
        );
    }

    function canAccessTrip(tripId) {
      return canAccessTripData(get(/databases/$(database)/documents/trips/$(tripId)).data);
    }

    // ============================================================
    // trips 主集合
    // ============================================================
    match /trips/{tripId} {
      allow get: if canAccessTripData(resource.data);
      allow list: if canListTripData(resource.data);
      allow update, delete: if canAccessTripData(resource.data);
      allow create: if canAccessTripData(request.resource.data);

      // 所有 trips/{tripId} 底下的子集合：
      // itinerary, expenses, images, todos, diveLogs, flights,
      // accommodations，以及未來新增的 trip 子集合。
      match /{subCollection}/{documentId=**} {
        allow read, write: if canAccessTrip(tripId);
      }
    }

    // ============================================================
    // users 集合（Google 登入後的使用者暱稱資料）
    // ============================================================
    // 只允許登入者讀寫自己的 users/{uid} 文件。
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // optionSets 集合（可自訂選項系統，未來版本使用）
    // ============================================================
    match /optionSets/{optionId} {
      allow read, write: if true;
    }

    // ============================================================
    // settings 集合（系統設定，未來版本使用）
    // ============================================================
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
